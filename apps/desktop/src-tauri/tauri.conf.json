{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fieldwork",
  "version": "0.1.0",
  "identifier": "dev.fieldwork.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Fieldwork",
        "width": 1440,
        "height": 940,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost https://github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "icon": ["icons/icon.png"],
    "category": "DeveloperTool",
    "shortDescription": "Open-source research and analysis workspace",
    "longDescription": "A modular desktop workspace for source-aware open-source research and analysis."
  }
}